{
  "name": "ai-weekly-report-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch app.js",
    "start": "node app.js",
    "verify:agent": "node scripts/verify-agent.mjs",
    "migrate": "node scripts/migrate-confirmation.mjs && node scripts/migrate-engineering.mjs",
    "verify:db": "node scripts/verify-database.mjs",
    "verify:engineering": "node scripts/verify-engineering.mjs",
    "verify:engineering:live": "node scripts/verify-engineering.mjs --live",
    "verify:rag": "node scripts/verify-engineering.mjs --live --embedding",
    "index:reports": "node scripts/index-reports.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.4"
  }
}
