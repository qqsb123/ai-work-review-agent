# Server
PORT=3001

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
# Agent only; generation/rewrite keep their existing model.
DEEPSEEK_AGENT_MODEL=deepseek-flash
DEEPSEEK_REPORT_MODEL=deepseek-chat

# Semantic retrieval: OpenAI-compatible POST /embeddings (independent provider).
# Leave blank for explicitly labelled keyword fallback. URL must be server-configured.
# Example for a locally installed Ollama multilingual embedding model:
# EMBEDDING_URL=http://127.0.0.1:11434/v1/embeddings
# EMBEDDING_MODEL=bge-m3
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_weekly_report

# JWT
JWT_SECRET=replace_with_a_long_random_secret
